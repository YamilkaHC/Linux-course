---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  titulo: string;
  descripcion?: string;
}

const { titulo, descripcion = 'Curso tecnico de Linux: lectura rapida, directa y aplicable en terminal.' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={descripcion} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Playfair+Display:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{titulo}</title>
  </head>
  <body>
    <Header />
    <main class="mx-auto max-w-3xl px-6 py-12 md:py-20">
      <slot />
    </main>
    <Footer />

    <script>
      // Al pulsar "Siguiente" (boton primario del nav) en una leccion,
      // se marca esa leccion como completada en el indice del inicio.
      const KEY = 'linux-curso-completadas';
      const m = location.pathname.match(/\/lecciones\/([^/]+?)(?:\.html)?\/?$/);

      if (m) {
        const slug = m[1];
        const boton = document.querySelector('nav a.btn-primario');

        boton?.addEventListener('click', () => {
          let actual: string[] = [];
          try {
            actual = JSON.parse(localStorage.getItem(KEY) || '[]');
          } catch {
            actual = [];
          }
          if (!actual.includes(slug)) {
            actual.push(slug);
            localStorage.setItem(KEY, JSON.stringify(actual));
          }
        });
      }
    </script>
  </body>
</html>
