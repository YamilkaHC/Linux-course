      <!-- líneas -->
      <line x1="260" y1="54" x2="60" y2="100" stroke="#E5E1D8" stroke-width="1.5"/>
      <line x1="260" y1="54" x2="160" y2="100" stroke="#E5E1D8" stroke-width="1.5"/>
      <line x1="260" y1="54" x2="260" y2="100" stroke="#E5E1D8" stroke-width="1.5"/>
      <line x1="260" y1="54" x2="360" y2="100" stroke="#E5E1D8" stroke-width="1.5"/>
      <line x1="260" y1="54" x2="460" y2="100" stroke="#E5E1D8" stroke-width="1.5"/>
      <!-- hijos -->
      <text x="60" y="118" font-family="Inter, sans-serif" font-size="13" fill="#1A1A1A" text-anchor="middle">/bin</text>
      <text x="160" y="118" font-family="Inter, sans-serif" font-size="13" fill="#1A1A1A" text-anchor="middle">/etc</text>
