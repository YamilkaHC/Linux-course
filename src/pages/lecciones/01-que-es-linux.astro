          <text x="240" y="60" font-family="Inter,sans-serif" font-size="11" fill="#1A1A1A" letter-spacing="0.5">PAQUETES DE SOFTWARE</text>
          <line x1="240" y1="70" x2="470" y2="70" stroke="#E5E1D8" stroke-width="1"/>
