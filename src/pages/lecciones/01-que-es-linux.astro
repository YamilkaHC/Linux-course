          <text x="355" y="155" text-anchor="middle" font-family="Inter,sans-serif" font-size="11" fill="#1A1A1A">núcleo empaquetado</text>
          <text x="355" y="172" text-anchor="middle" font-family="Inter,sans-serif" font-size="11" fill="#1A1A1A">con software elegido</text>
          <line x1="490" y1="80" x2="555" y2="80" stroke="#1A1A1A" stroke-width="1.5"/>
          <line x1="490" y1="150" x2="555" y2="150" stroke="#1A1A1A" stroke-width="1.5"/>
          <line x1="490" y1="220" x2="555" y2="220" stroke="#1A1A1A" stroke-width="1.5"/>
          <text x="570" y="84" font-family="Inter,sans-serif" font-size="13" font-weight="600" fill="#1A1A1A">Debian</text>
          <text x="570" y="154" font-family="Inter,sans-serif" font-size="13" fill="#1A1A1A">Ubuntu</text>
          <text x="570" y="224" font-family="Inter,sans-serif" font-size="13" fill="#1A1A1A">Fedora...</text>
        </svg>
