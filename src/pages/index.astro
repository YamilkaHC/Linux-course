    <h1 class="font-display text-5xl md:text-6xl font-bold  leading-tight">
      Aprende Linux
    </h1>
   
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="#lecciones" class="btn-primario">Empezar</a>
      <a href="/Linux-course/practicas" class="btn-secundario">Prácticas de campo</a>
    </div>
  </section>

