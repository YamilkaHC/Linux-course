<style>
  .leccion-item.completada .leccion-titulo {
    color: rgba(26, 26, 26, 0.35);
    text-decoration: line-through;
  }
  .leccion-item.completada .num {
    color: rgba(26, 26, 26, 0.25);
  }
</style>

<script>
  const KEY = 'linux-curso-completadas';

  function leer(): string[] {
    try {
      return JSON.parse(localStorage.getItem(KEY) || '[]');
    } catch {
      return [];
    }
  }

  function guardar(slugs: string[]) {
    localStorage.setItem(KEY, JSON.stringify(slugs));
  }

  function actualizarProgreso() {
    const total = document.querySelectorAll('.leccion-check').length;
    const hechas = document.querySelectorAll('.leccion-check:checked').length;
    const num = document.getElementById('progreso-num');
    const barra = document.getElementById('progreso-barra');
    if (num) num.textContent = String(hechas);
    if (barra) barra.style.width = total ? `${(hechas / total) * 100}%` : '0%';
  }

  const completadas = leer();

  document.querySelectorAll<HTMLInputElement>('.leccion-check').forEach((chk) => {
    const slug = chk.dataset.slug!;
    const item = chk.closest('.leccion-item');
    if (completadas.includes(slug)) {
      chk.checked = true;
      item?.classList.add('completada');
    }
    chk.addEventListener('change', () => {
      const actual = leer();
      if (chk.checked) {
        if (!actual.includes(slug)) actual.push(slug);
        item?.classList.add('completada');
      } else {
        const idx = actual.indexOf(slug);
        if (idx > -1) actual.splice(idx, 1);
        item?.classList.remove('completada');
      }
      guardar(actual);
      actualizarProgreso();
    });
  });

  actualizarProgreso();
</script>
